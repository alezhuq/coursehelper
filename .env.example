# Copy this file to .env and fill in real values for local development.
# .env is gitignored; never commit real secrets.

# --- Postgres ---
POSTGRES_DB=studentlib
POSTGRES_USER=studentlib
# Choose a local dev password.
POSTGRES_PASSWORD=changeme

# --- API ---
# Built from the Postgres vars above; used by the api and worker services.
DATABASE_URL=postgresql+asyncpg://studentlib:changeme@db:5432/studentlib

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=changeme-generate-a-real-secret

# Base URL the api uses to build absolute links (magic-link emails, CAS callback).
APP_BASE_URL=http://localhost:8080

# development | production
ENVIRONMENT=development

# --- Dev mail (docker-compose.override.yml Mailpit service) ---
SMTP_HOST=mail
SMTP_PORT=1025

# --- Ingestion pipeline ---
# Parse-stage wall-clock ceiling in seconds. run_pipeline wraps the Docling
# parse in asyncio.wait_for(this) so a pathological PDF fails as a readable
# [parse] timeout instead of hanging the concurrency=1 worker. Derived from
# a load test: a real 769-page dense STEM textbook parsed in
# 32.5 min on CPU-only hardware, so 3600s (60 min) gives ~1.85x margin and is
# well clear of any target-range (300-500pg) book.
INGEST_PARSE_TIMEOUT_SECONDS=3600
